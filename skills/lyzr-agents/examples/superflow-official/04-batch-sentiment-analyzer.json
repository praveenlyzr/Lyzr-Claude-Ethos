{"name":"Batch Sentiment Analyzer","nodes":[{"id":"node_0","name":"Trigger","type":"lyzr-nodes-base.trigger","parameters":{"inputSchema":[{"name":"texts","type":"string","required":true,"multiline":true,"description":"Texts to classify, one per line"}]},"position":[200,200]},{"id":"node_1","name":"Split Lines","type":"lyzr-nodes-base.code","parameters":{"jsCode":"const raw = $json.texts || '';\nraw.split('\\n').map(t => t.trim()).filter(Boolean).map(text => ({ json: { text } }));"},"position":[520,200]},{"id":"node_2","name":"Loop","type":"lyzr-nodes-base.splitInBatches","parameters":{"mode":"each","batchSize":1},"position":[840,200]},{"id":"node_3","name":"Classify","type":"lyzr-nodes-base.lyzr.llm","parameters":{"model":"gpt-4o-mini","prompt":"={{ $json.text }}","provider":"openai","maxTokens":128,"temperature":0,"systemPrompt":"Classify the sentiment of the input text. confidence is your certainty from 0.0 to 1.0.","responseFormat":{"type":"json_schema","json_schema":{"name":"sentiment","schema":{"type":"object","required":["sentiment","confidence"],"properties":{"sentiment":{"enum":["positive","negative","neutral"],"type":"string"},"confidence":{"type":"number"}},"additionalProperties":false},"strict":true}}},"position":[1160,320]},{"id":"node_4","name":"Output","type":"lyzr-nodes-base.noOp","parameters":{},"position":[1160,120]}],"connections":{"Loop":{"main":[[{"node":"Classify","type":"main","index":0}],[{"node":"Output","type":"main","index":0}]]},"Trigger":{"main":[[{"node":"Split Lines","type":"main","index":0}]]},"Split Lines":{"main":[[{"node":"Loop","type":"main","index":0}]]}}}
