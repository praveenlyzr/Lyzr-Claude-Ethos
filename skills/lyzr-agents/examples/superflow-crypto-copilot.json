{
  "name": "Crypto Copilot",
  "nodes": [
    {
      "id": "node_trigger",
      "name": "Trigger",
      "type": "lyzr-nodes-base.trigger",
      "parameters": {
        "inputSchema": [
          {
            "name": "chatInput",
            "type": "string",
            "required": true,
            "multiline": true,
            "description": "Ask anything about crypto: 'price of SOL', 'how risky is ETH', 'compare BTC vs SOL', 'explain restaking risks'"
          }
        ]
      },
      "position": [
        40,
        460
      ]
    },
    {
      "id": "node_classifier",
      "name": "Classifier",
      "type": "lyzr-nodes-base.lyzr.llm",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "prompt": "={{ $json.chatInput }}",
        "maxTokens": 128,
        "temperature": 0,
        "systemPrompt": "Classify the user's crypto request into ONE intent and extract coins.\n- price: they just want a current price of one coin.\n- risk: they want a risk read on ONE specific coin.\n- compare: they want two or MORE coins compared, OR a recommendation/pick among several (e.g. 'which is safest', 'what should I invest in: X, Y or Z', 'X vs Y vs Z').\n- research: open-ended explainer / 'why' / 'what is' / deep-dive.\nExtract coin_a/symbol_a = the primary single coin (default bitcoin/BTC). coin_ids = comma-separated CoinGecko id slugs of ALL coins mentioned, lowercase (e.g. 'bitcoin,solana,ethereum'); if none mentioned, 'bitcoin'.",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "route",
            "strict": true,
            "schema": {
              "type": "object",
              "required": [
                "intent",
                "coin_a",
                "symbol_a",
                "coin_ids"
              ],
              "properties": {
                "intent": {
                  "enum": [
                    "price",
                    "risk",
                    "compare",
                    "research"
                  ],
                  "type": "string"
                },
                "coin_a": {
                  "type": "string",
                  "description": "primary CoinGecko slug"
                },
                "symbol_a": {
                  "type": "string",
                  "description": "primary ticker, e.g. BTC"
                },
                "coin_ids": {
                  "type": "string",
                  "description": "comma-separated CoinGecko slugs of all coins mentioned"
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "position": [
        300,
        460
      ]
    },
    {
      "id": "node_route",
      "name": "Route",
      "type": "lyzr-nodes-base.switch",
      "parameters": {
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftType": "string",
                    "leftValue": "={{ $json.output.intent }}",
                    "operation": "equals",
                    "rightType": "string",
                    "rightValue": "price"
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftType": "string",
                    "leftValue": "={{ $json.output.intent }}",
                    "operation": "equals",
                    "rightType": "string",
                    "rightValue": "risk"
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftType": "string",
                    "leftValue": "={{ $json.output.intent }}",
                    "operation": "equals",
                    "rightType": "string",
                    "rightValue": "compare"
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftType": "string",
                    "leftValue": "={{ $json.output.intent }}",
                    "operation": "equals",
                    "rightType": "string",
                    "rightValue": "research"
                  }
                ]
              }
            }
          ]
        }
      },
      "position": [
        560,
        460
      ]
    },
    {
      "id": "node_price_fetch",
      "name": "Fetch Price",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "=https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids={{ $('Classifier').json.output.coin_a }}&price_change_percentage=24h",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": {
        "retryOnFail": true,
        "backoff": "exponential"
      },
      "position": [
        840,
        60
      ]
    },
    {
      "id": "node_price_answer",
      "name": "Price Answer",
      "type": "lyzr-nodes-base.lyzr.llm",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "maxTokens": 256,
        "temperature": 0.2,
        "prompt": "=Coin: {{ $('Classifier').json.output.coin_a }}\nData: {{ $('Fetch Price').json.body }}",
        "systemPrompt": "Report the coin's current USD price and 24h % change in one or two short lines of PLAIN TEXT (no markdown). Use the real numbers. Nothing else."
      },
      "position": [
        1100,
        60
      ]
    },
    {
      "id": "node_price_out",
      "name": "Price Output",
      "type": "lyzr-nodes-base.noOp",
      "parameters": {
        "outputField": "output"
      },
      "position": [
        1360,
        60
      ]
    },
    {
      "id": "node_risk_market",
      "name": "Risk Markets",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "=https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids={{ $('Classifier').json.output.coin_a }}&price_change_percentage=24h",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": {
        "retryOnFail": true,
        "backoff": "exponential"
      },
      "position": [
        840,
        240
      ]
    },
    {
      "id": "node_risk_global",
      "name": "Risk Global",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/global",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": {
        "retryOnFail": true,
        "backoff": "exponential"
      },
      "position": [
        1060,
        240
      ]
    },
    {
      "id": "node_risk_sent",
      "name": "Risk Sentiment",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.alternative.me/fng/?limit=1",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": {
        "retryOnFail": true,
        "backoff": "exponential"
      },
      "position": [
        1280,
        240
      ]
    },
    {
      "id": "node_risk_analyst",
      "name": "Risk Analyst",
      "type": "lyzr-nodes-base.lyzr.llm",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "maxTokens": 1536,
        "temperature": 0.3,
        "prompt": "=Coin: {{ $('Classifier').json.output.coin_a }}\n\nMarket: {{ $('Risk Markets').json.body }}\n\nGlobal: {{ $('Risk Global').json.body }}\n\nFear & Greed: {{ $('Risk Sentiment').json.body }}",
        "systemPrompt": "You are a crypto risk analyst. Write a short risk brief in PLAIN TEXT only — no markdown (no #, *, tables, or bullet symbols); use simple labeled lines. Include: a one-line headline; a 'Price:' line with 24h %; a 'Regime:' line (BTC dominance + total-cap trend + Fear & Greed); a 'Risk:' line that is exactly Calm / Elevated / High with a one-line rationale (High if |24h| >= 8% or Fear&Greed <=25 or >=80; Elevated if |24h| >= 4% or Fear&Greed <=40 or >=70; else Calm); a 'Watch:' line with two things. End with 'Not financial advice - always do your own research.' Use real numbers."
      },
      "position": [
        1500,
        240
      ]
    },
    {
      "id": "node_risk_out",
      "name": "Risk Output",
      "type": "lyzr-nodes-base.noOp",
      "parameters": {
        "outputField": "output"
      },
      "position": [
        1720,
        240
      ]
    },
    {
      "id": "node_cmp_fetch",
      "name": "Compare Markets",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "=https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids={{ $('Classifier').json.output.coin_ids }}&price_change_percentage=24h",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": {
        "retryOnFail": true,
        "backoff": "exponential"
      },
      "position": [
        840,
        520
      ]
    },
    {
      "id": "node_cmp_analyst",
      "name": "Compare Analyst",
      "type": "lyzr-nodes-base.lyzr.llm",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "maxTokens": 1536,
        "temperature": 0.3,
        "prompt": "=Coins: {{ $('Classifier').json.output.coin_ids }}\n\nMarkets: {{ $('Compare Markets').json.body }}",
        "systemPrompt": "You compare crypto coins for an investor and recommend the SAFEST option. PLAIN TEXT only — no markdown, no tables. Give one line per coin: name, price, 24h % change, market cap. Then a 'Verdict:' line that names the relatively safest pick (heuristic: larger market cap + smaller 24h move = relatively safer) and one sentence why. Add a one-line caveat that all crypto is high-risk and this is not financial advice. Use real numbers."
      },
      "position": [
        1100,
        520
      ]
    },
    {
      "id": "node_cmp_out",
      "name": "Compare Output",
      "type": "lyzr-nodes-base.noOp",
      "parameters": {
        "outputField": "output"
      },
      "position": [
        1360,
        520
      ]
    },
    {
      "id": "node_research",
      "name": "Research Swarm",
      "type": "lyzr-nodes-base.lyzr.taskDecomposition",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "prompt": "={{ $('Trigger').json.chatInput }}",
        "maxTokens": 2048,
        "maxSubtasks": 5,
        "temperature": 0.4,
        "decompositionPrompt": "Break this crypto question into 3-5 focused, non-overlapping sub-questions (e.g. mechanism, adoption, risks, catalysts, competition). Each answerable in 2-3 sentences. Numbered list.",
        "aggregationPrompt": "You are a crypto research editor. Synthesize the sub-answers into a PLAIN-TEXT brief — no markdown (no #, *, or bullet symbols). Use short labeled lines: Overview, Key findings, Risks, Open questions. Concise. End with 'Not financial advice - always do your own research.'"
      },
      "position": [
        840,
        700
      ]
    },
    {
      "id": "node_research_out",
      "name": "Research Output",
      "type": "lyzr-nodes-base.noOp",
      "parameters": {
        "outputField": "output"
      },
      "position": [
        1100,
        700
      ]
    }
  ],
