{
  "name": "Crypto Risk Desk",
  "nodes": [
    {
      "id": "node_trigger",
      "name": "Trigger",
      "type": "lyzr-nodes-base.trigger",
      "parameters": {
        "inputSchema": [
          { "name": "chatInput", "type": "string", "required": true, "multiline": true,
            "description": "A coin or question, e.g. 'How risky is Solana right now?' or 'Bitcoin and Ethereum'" }
        ]
      },
      "position": [120, 320]
    },
    {
      "id": "node_extract",
      "name": "Extract Coin",
      "type": "lyzr-nodes-base.lyzr.llm",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "prompt": "={{ $json.chatInput }}",
        "maxTokens": 64,
        "temperature": 0,
        "systemPrompt": "Extract the CoinGecko coin id(s) from the user's message as a lowercase comma-separated slug list (e.g. 'bitcoin', 'ethereum', 'bitcoin,solana'). Use canonical CoinGecko ids. If none is mentioned, return 'bitcoin'.",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "coin",
            "strict": true,
            "schema": {
              "type": "object",
              "required": ["coin_id"],
              "properties": { "coin_id": { "type": "string", "description": "comma-separated CoinGecko ids" } },
              "additionalProperties": false
            }
          }
        }
      },
      "position": [380, 320]
    },
    {
      "id": "node_fetch_price",
      "name": "Fetch Price",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "=https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids={{ $('Extract Coin').json.output.coin_id }}&price_change_percentage=24h",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": { "retryOnFail": true, "backoff": "exponential" },
      "position": [640, 160]
    },
    {
      "id": "node_fetch_global",
      "name": "Fetch Global",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/global",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": { "retryOnFail": true, "backoff": "exponential" },
      "position": [640, 320]
    },
    {
      "id": "node_fetch_sentiment",
      "name": "Fetch Sentiment",
      "type": "lyzr-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.alternative.me/fng/?limit=1",
        "method": "GET",
        "sendHeaders": false
      },
      "settings": { "retryOnFail": true, "backoff": "exponential" },
      "position": [640, 480]
    },
    {
      "id": "node_analyst",
      "name": "Risk Analyst",
      "type": "lyzr-nodes-base.lyzr.llm",
      "parameters": {
        "model": "gpt-4o-mini",
        "provider": "openai",
        "prompt": "=Coin(s): {{ $('Extract Coin').json.output.coin_id }}\n\nPer-coin market data (CoinGecko):\n{{ $('Fetch Price').json.body }}\n\nGlobal market (CoinGecko):\n{{ $('Fetch Global').json.body }}\n\nFear & Greed index:\n{{ $('Fetch Sentiment').json.body }}",
        "maxTokens": 2048,
        "temperature": 0.3,
        "systemPrompt": "You are a crypto risk desk analyst. You are given live data: per-coin market figures (price, 24h % change, 24h volume, market cap, ATH), the global market (total market cap, BTC dominance, 24h total-cap % change), and the Fear & Greed index (0-100 + label).\n\nWrite ONE concise desk brief with these sections:\n- Headline (one line)\n- Snapshot — per coin: price and 24h %\n- Market Regime — risk-on vs risk-off, from BTC dominance + total-cap trend + Fear & Greed\n- Risk Level — exactly one of Calm / Elevated / High, with a one-line rationale (High if any coin's |24h| >= 8% or Fear&Greed <=25 or >=80; Elevated if |24h| >= 4% or Fear&Greed <=40 or >=70; else Calm)\n- What to Watch — 2 bullets\n\nUse the real numbers, name each coin, and end with 'Not financial advice - always do your own research.'"
      },
      "position": [920, 320]
    },
    {
      "id": "node_output",
      "name": "Output",
      "type": "lyzr-nodes-base.noOp",
      "parameters": { "outputField": "output", "outputSourceNode": "Risk Analyst" },
      "position": [1200, 320]
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Extract Coin", "type": "main", "index": 0 }]] },
    "Extract Coin": { "main": [[{ "node": "Fetch Price", "type": "main", "index": 0 }]] },
    "Fetch Price": { "main": [[{ "node": "Fetch Global", "type": "main", "index": 0 }]] },
    "Fetch Global": { "main": [[{ "node": "Fetch Sentiment", "type": "main", "index": 0 }]] },
    "Fetch Sentiment": { "main": [[{ "node": "Risk Analyst", "type": "main", "index": 0 }]] },
    "Risk Analyst": { "main": [[{ "node": "Output", "type": "main", "index": 0 }]] }
  }
}
